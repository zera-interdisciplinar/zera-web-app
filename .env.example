# Configuração pública, incorporada ao navegador: nunca coloque segredos aqui.
VITE_ROUTER_MODE=history
VITE_API_BASE_URL=https://zera-web-app-kappa.vercel.app/api/analytics
VITE_ADMIN_API_URL=https://zera-web-app-kappa.vercel.app/api/administrative
VITE_INVENTORY_API_URL=https://zera-web-app-kappa.vercel.app/api/inventory
# Dados controlados ficam restritos ao modo de testes automatizados.
VITE_USE_MSW=false
# URLs opcionais de documentação, sem credenciais.
VITE_ADMIN_OPENAPI_URL=
VITE_INVENTORY_OPENAPI_URL=

# Proxy local opcional. As variáveis abaixo não são necessárias para rodar o app,
# que usa por padrão os endereços públicos HTTPS configurados acima.
# Raiz HTTPS de cada serviço, sem /api nem /swagger-ui.
# HTTP somente em localhost/127.0.0.1/::1, nunca em host remoto.
# ZERA_ADMIN_URL=
# Alias legado da base administrativa.
# ZERA_ADMIN_API_ORIGIN=
# ZERA_INVENTORY_API_ORIGIN=
# ZERA_ANALYTICS_URL=
# ZERA_APP_API_KEY=
# ZERA_PROXY_PORT=8787
# ZERA_WEB_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,http://localhost:4173

# Definidas pela plataforma Vercel, não copie valores para este arquivo.
# VERCEL_URL=
# VERCEL_PROJECT_PRODUCTION_URL=

# Contas locais de teste, nunca prefixar e-mail/senha com VITE_.
# MANAGER: inventário da unidade, categorias, modelos, itens, remoção e usuários.
ZERA_QA_GESTOR_EMAIL=
ZERA_QA_GESTOR_PASSWORD=
# EMPLOYEE: cadastrar modelos/itens, editar e acompanhar os próprios itens.
ZERA_QA_FUNCIONARIO_EMAIL=
ZERA_QA_FUNCIONARIO_PASSWORD=
# ADMIN não está definido no contrato administrativo consultado.
# Nomes legados aceitos pelos testes Node, sem login remoto automático.
QA_GESTOR_EMAIL=
QA_GESTOR_PASSWORD=
QA_OPERARIO_EMAIL=
QA_OPERARIO_PASSWORD=
# Login remoto de navegador exige ativação explícita; os testes comuns usam respostas controladas.
ZERA_RUN_LIVE_QA=false
