  "openapi": "3.1.0",
  "schemas": {
    "ModelResponse": {
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "format": "uuid"
        },
        "unitId": {
          "type": "string",
          "format": "uuid"
        },
        "name": {
          "type": "string"
        },
        "manufacturer": {
          "type": "string"
        },
        "warrantyMonths": {
          "type": "integer",
          "format": "int32"
        },
        "expectedLifespanMonths": {
          "type": "integer",
          "format": "int32"
        },
        "materials": {
          "type": "array",
          "items": {
            "$ref": "#/components/schemas/MaterialResponse"
          }
        },
        "hazardous": {
          "type": "boolean"
        },
        "estimatedWeightKg": {
          "type": "number",
          "format": "double"
        },
        "notes": {
          "type": "string"
        },
        "category": {
          "$ref": "#/components/schemas/CategoryResponse"
        },
        "approvalStatus": {
          "type": "string",
          "enum": [
            "PENDING",
            "APPROVED",
            "REJECTED"
          ]
        },
        "rejectionReason": {
          "type": "string"
        },
        "createdBy": {
          "type": "string",
          "format": "uuid"
        },
        "reviewedBy": {
          "type": "string",
          "format": "uuid"
        },
        "reviewedAt": {
          "type": "string",
          "format": "date-time"
        },
        "createdAt": {
          "type": "string",
          "format": "date-time"
        },
        "updatedAt": {
          "type": "string",
          "format": "date-time"
        }
      }
    },
    "EventResponse": {
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "format": "uuid"
        },
        "itemId": {
          "type": "string",
          "format": "uuid"
        },
        "type": {
          "type": "string",
          "enum": [
            "CREATED",
            "SUBMITTED",
            "APPROVED",
            "REJECTED",
            "MAINTENANCE_STARTED",
            "MAINTENANCE_FINISHED",
            "EVALUATED",
            "DISPOSED",
            "REMOVED",
            "RESTORED",
            "STATUS_CHANGED"
          ]
        },
        "fromStatus": {
          "type": "string",
          "enum": [
            "DRAFT",
            "PENDING_APPROVAL",
            "REJECTED",
            "IN_STOCK",
            "IN_MAINTENANCE",
            "AWAITING_EVALUATION",
            "DISPOSED",
            "REMOVED"
          ]
        },
        "toStatus": {
          "type": "string",
          "enum": [
            "DRAFT",
            "PENDING_APPROVAL",
            "REJECTED",
            "IN_STOCK",
            "IN_MAINTENANCE",
            "AWAITING_EVALUATION",
            "DISPOSED",
            "REMOVED"
          ]
        },
        "reason": {
          "type": "string"
        },
        "actorId": {
          "type": "string",
          "format": "uuid"
        },
        "actorName": {
          "type": "string"
        },
        "occurredAt": {
          "type": "string",
          "format": "date-time"
        }
      }
    },
    "DisposalResponse": {
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "format": "uuid"
        },
        "unitId": {
          "type": "string",
          "format": "uuid"
        },
        "destination": {
          "type": "string",
          "enum": [
            "RECYCLING",
            "LANDFILL",
            "DONATION"
          ]
        },
        "placeId": {
          "type": "string"
        },
        "placeName": {
          "type": "string"
        },
        "disposedAt": {
          "type": "string",
          "format": "date"
        },
        "notes": {
          "type": "string"
        },
        "items": {
          "type": "array",
          "items": {
            "$ref": "#/components/schemas/DisposedItemResponse"
          }
        },
        "totalWeightKg": {
          "type": "number",
          "format": "double"
        },
        "createdBy": {
          "type": "string",
          "format": "uuid"
        },
        "createdByName": {
          "type": "string"
        },
        "createdAt": {
          "type": "string",
          "format": "date-time"
        },
        "updatedAt": {
          "type": "string",
          "format": "date-time"
        }
      }
    },
    "UpdateItemRequest": {
      "type": "object",
      "properties": {
        "name": {
          "type": "string",
          "maxLength": 120,
          "minLength": 1
        },
        "condition": {
          "type": "string",
          "enum": [
            "NEW",
            "USED",
            "SEMI_DAMAGED",
            "DAMAGED"
          ]
        },
        "hasDamages": {
          "type": "boolean"
        },
        "damages": {
          "type": "array",
          "items": {
            "type": "string",
            "enum": [
              "BROKEN_SCREEN",
              "MISSING_PART",
              "DOES_NOT_POWER_ON",
              "OXIDATION",
              "OTHER"
            ]
          },
          "uniqueItems": true
        },
        "notes": {
          "type": "string",
          "maxLength": 500,
          "minLength": 0
        },
        "serialNumber": {
          "type": "string",
          "maxLength": 120,
          "minLength": 0
        },
        "acquiredAt": {
          "type": "string",
          "format": "date"
        },
        "manufacturingYear": {
          "type": "integer",
          "format": "int32"
        },
        "usageIntensity": {
          "type": "integer",
          "format": "int32",
          "maximum": 10,
          "minimum": 0
        }
      }
    },
    "CreateCategoryRequest": {
      "type": "object",
      "properties": {
        "name": {
          "type": "string",
          "minLength": 1
        },
        "description": {
          "type": "string",
          "minLength": 1
        }
      },
      "required": [
        "description",
        "name"
      ]
    },
    "PageResponseItemResponse": {
      "type": "object",
      "properties": {
        "content": {
          "type": "array",
          "items": {
            "$ref": "#/components/schemas/ItemResponse"
          }
        },
        "page": {
          "type": "integer",
          "format": "int32"
        },
        "size": {
          "type": "integer",
          "format": "int32"
        },
        "totalElements": {
          "type": "integer",
          "format": "int64"
        },
        "totalPages": {
          "type": "integer",
          "format": "int32"
        }
      }
    },
    "UnitSettingsResponse": {
      "type": "object",
      "properties": {
        "unitId": {
          "type": "string",
          "format": "uuid"
        },
        "stockCapacity": {
          "type": "integer",
          "format": "int32"
        },
        "configured": {
          "type": "boolean"
        },
        "updatedBy": {
          "type": "string",
          "format": "uuid"
        },
        "updatedByName": {
          "type": "string"
        },
        "updatedAt": {
          "type": "string",
          "format": "date-time"
        }
      }
    },
    "ItemResponse": {
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "format": "uuid"
        },
        "barcode": {
          "type": "string"
        },
        "displayCode": {
          "type": "string"
        },
        "name": {
          "type": "string"
        },
        "status": {
          "type": "string",
          "enum": [
            "DRAFT",
            "PENDING_APPROVAL",
            "REJECTED",
            "IN_STOCK",
            "IN_MAINTENANCE",
            "AWAITING_EVALUATION",
            "DISPOSED",
            "REMOVED"
          ]
        },
        "condition": {
          "type": "string",
          "enum": [
            "NEW",
            "USED",
            "SEMI_DAMAGED",
            "DAMAGED"
          ]
        },
        "hasDamages": {
          "type": "boolean"
        },
        "damages": {
          "type": "array",
          "items": {
            "type": "string",
            "enum": [
              "BROKEN_SCREEN",
