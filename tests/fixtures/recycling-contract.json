{
  "consultadoEm": "2026-10-28",
  "paths": {
    "/api/v1/recyclings": {
      "get": {
        "operationId": "findAll_1",
        "responses": {
          "200": {
            "content": {
              "*/*": {
                "schema": {
                  "type": "array",
                  "items": {
                    "$ref": "#/components/schemas/RecyclingBusiness"
                  }
                }
              }
            }
          }
        }
      },
      "post": {
        "operationId": "register_2",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/RegisterRecyclingRequest"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "content": {
              "*/*": {
                "schema": {
                  "$ref": "#/components/schemas/RecyclingBusiness"
                }
              }
            }
          }
        }
      }
    },
    "/api/v1/recycling-places": {
      "get": {
        "operationId": "findNearby",
        "parameters": [
          {
            "name": "lat",
            "in": "query",
            "required": true,
            "schema": {
              "type": "number",
              "format": "double"
            }
          },
          {
            "name": "lng",
            "in": "query",
            "required": true,
            "schema": {
              "type": "number",
              "format": "double"
            }
          },
          {
            "name": "radiusMeters",
            "in": "query",
            "required": false,
            "schema": {
              "type": "integer",
              "format": "int32"
            }
          }
        ],
        "responses": {
          "200": {
            "content": {
              "*/*": {
                "schema": {
                  "type": "array",
                  "items": {
                    "$ref": "#/components/schemas/RecyclingPlaceOutput"
                  }
                }
              }
            }
          }
        }
      }
    }
  },
  "schemas": {
    "RegisterRecyclingRequest": {
      "type": "object",
      "properties": {
        "name": {
          "type": "string"
        },
        "cnpj": {
          "type": "string"
        },
        "email": {
          "type": "string"
        }
      }
    },
    "RecyclingBusiness": {
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "format": "uuid"
        },
        "name": {
          "type": "string"
        },
        "cnpj": {
          "type": "string"
        },
        "email": {
          "type": "string"
        },
        "placeId": {
          "type": "string"
        },
        "createdAt": {
          "type": "string",
          "format": "date-time"
        },
        "updatedAt": {
          "type": "string",
          "format": "date-time"
        }
      }
    },
    "RecyclingPlaceOutput": {
      "type": "object",
      "properties": {
        "placeId": {
          "type": "string"
        },
        "name": {
          "type": "string"
        },
        "address": {
          "type": "string"
        },
        "lat": {
          "type": "number",
          "format": "double"
        },
        "lng": {
          "type": "number",
          "format": "double"
        },
        "distanceMeters": {
          "type": "integer",
          "format": "int64"
        },
        "isOpen": {
          "type": "boolean"
        },
        "openingHours": {
          "type": "array",
          "items": {
            "$ref": "#/components/schemas/OpeningHoursOutput"
          }
        },
        "recyclingBusinessId": {
          "type": "string",
          "format": "uuid"
        },
        "email": {
          "type": "string"
        }
      }
    }
  }
}
